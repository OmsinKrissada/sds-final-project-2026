# Copy to .env (gitignored) and edit. Read by scripts/*.sh and db/docker-compose.yml.
# Plain KEY=VALUE, no spaces around "=". Prefer alphanumeric passwords.

# --- Images -------------------------------------------------------------
# Registry namespace images are pushed to / pulled from (lowercase!).
# Images are named $REGISTRY/quizbox-<gateway|frontend|account|quiz|game>:$TAG
# NOTE: GHCR packages are private by default; make them public (or add an
# imagePullSecret) so the Raspberry Pis can pull them.
REGISTRY=ghcr.io/myorg
# Tag to build/deploy. "latest" works, but with imagePullPolicy IfNotPresent a
# node keeps its cached :latest; use an immutable tag (e.g. sha-abc1234) to roll out.
TAG=latest

# --- Postgres (Docker on the Ubuntu VM, outside the cluster) --------------
# LAN IP of the VM; becomes the EndpointSlice address behind Service "postgres".
DB_HOST=192.168.0.10
DB_NAME=quizbox
# Superuser used by the postgres container (db/docker-compose.yml).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-admin
# Per-service roles created by db/roles.sh (each only sees its own schema).
ACCOUNT_DB_PASSWORD=change-me-account
QUIZ_DB_PASSWORD=change-me-quiz
GAME_DB_PASSWORD=change-me-game

# --- Cluster (cluster/*.sh, make cluster-server / cluster-agent) -----------
# Network interface of the VM on the LAN (flannel uses it). Auto-detected if empty.
IFACE=
# For agents: https://<VM LAN IP>:6443 and the token printed by cluster/server.sh.
K3S_URL=
K3S_TOKEN=
